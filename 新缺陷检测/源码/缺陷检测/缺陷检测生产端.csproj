<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\..\..\其他\构建\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\..\..\其他\构建\bin\</BaseOutputPath>
    <GalaxySdkRoot Condition="'$(GalaxySdkRoot)' == ''">D:\GalaxySDK</GalaxySdkRoot>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8625</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>缺陷检测生产端V2</AssemblyName>
    <RootNamespace>缺陷检测生产端</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="GxIAPINET">
      <HintPath>$(GalaxySdkRoot)\Development\Samples\CSharp\x64\DoNET\.NET6.0\GxIAPINET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\其他\构建\引擎\检测引擎\**\*" Link="算法引擎\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Link="使用说明.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\APIDll\Win64\GxIAPI.dll" Link="GxIAPI.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\APIDll\Win64\DxImageProc.dll" Link="DxImageProc.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\APIDll\Win64\concrt140.dll" Link="concrt140.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\APIDll\Win64\msvcp140.dll" Link="msvcp140.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\APIDll\Win64\vcomp140.dll" Link="vcomp140.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\APIDll\Win64\vcruntime140.dll" Link="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\GenICam\bin\Win64_x64\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(GalaxySdkRoot)\GenTL\Win64\*.cti" Link="GenTL\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
